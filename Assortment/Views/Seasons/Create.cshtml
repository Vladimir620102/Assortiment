@using Assortment.Domain.Entities
@model Season
@{
    ViewData["Title"] = "Новый сезон";
}

<h1>Новый сезон</h1>

<form asp-action="Create" method="post" class="col-md-6">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Kind" class="form-label"></label>
        <select asp-for="Kind" class="form-select"
                asp-items="Html.GetEnumSelectList<SeasonKind>()">
            <option value="">— выберите тип —</option>
        </select>
        <span asp-validation-for="Kind" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Лето 2027" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Translate" class="form-label"></label>
        <input asp-for="Translate" class="form-control" placeholder="Summer 2027" />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ExternalCode" class="form-label"></label>
            <input asp-for="ExternalCode" class="form-control" placeholder="1" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="LabelName" class="form-label"></label>
            <input asp-for="LabelName" class="form-control" placeholder="ЛЕТО 2027" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="ExpireDate" class="form-label"></label>
        <input asp-for="ExpireDate" class="form-control" type="date" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
