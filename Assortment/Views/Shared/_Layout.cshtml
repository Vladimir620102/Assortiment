<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Assortment</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
</head>
<body>
    <div class="d-flex">
        <nav class="bg-light border-end p-3" style="min-width: 240px; min-height: 100vh;">
            <h5 class="mb-3">Assortment</h5>
            @await Component.InvokeAsync("MainMenu")
        </nav>
        <main class="flex-grow-1 p-4">
            @if (TempData["Success"] is string msg)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @msg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>